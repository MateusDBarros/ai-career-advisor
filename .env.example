# IBM watsonx.ai Configuration
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here
IBM_WATSONX_PROJECT_ID=your_project_id_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com  # Change based on your region

# Model Configuration
LLM_MODEL=ibm/granite-3-8b-instruct  # Granite 3.0 8B Instruct
EMBEDDING_MODEL=ibm/slate-125m-english-rtrvr  # IBM Slate embeddings
MAX_TOKENS=4096
TEMPERATURE=0.7

# IBM Cloud Object Storage (optional, for storing documents)
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_API_KEY=your_cos_api_key_here
IBM_COS_INSTANCE_ID=your_cos_instance_id_here
IBM_COS_BUCKET_NAME=career-advisor-data

# Vector Store Configuration
VECTOR_STORE_TYPE=faiss  # Options: faiss, milvus, chroma
MILVUS_HOST=localhost
MILVUS_PORT=19530
VECTOR_DIMENSION=1536  # For text-embedding-3-small

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# API Configuration (for future FastAPI)
API_HOST=0.0.0.0
API_PORT=8000

# Search Configuration
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# Web Search (optional, for future)
SERPER_API_KEY=your_serper_api_key_here